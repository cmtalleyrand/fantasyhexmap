# Copy to .env. The key is read by the Express server only and is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# PORT=8787
# HEXMAP_MODEL=claude-opus-5
# HEXMAP_EFFORT=high          # low | medium | high | xhigh | max
# HEXMAP_MOCK=1               # run the offline procedural generator instead of calling the API
